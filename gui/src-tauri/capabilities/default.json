{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        {
          "url": "https://github.com/yangfan000818-droid/git-gui/releases/*"
        }
      ]
    },
    "dialog:allow-open",
    "dialog:allow-ask",
    "dialog:allow-message",
    "updater:allow-check",
    "updater:allow-download-and-install"
  ]
}
